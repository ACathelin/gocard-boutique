# =============================================================================
# App
# =============================================================================
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Database + Redis
# -----------------------------------------------------------------------------
# docker-compose fills these automatically. Override here for external hosts.
# =============================================================================
DATABASE_URL=postgres://boutique:boutique@postgres:5432/boutique
REDIS_URL=redis://redis:6379

# =============================================================================
# Worldline GoPay (required for real checkout — the rest of the app still runs
# in read-only mode without them; checkout attempts will fail with 500)
# -----------------------------------------------------------------------------
# Get test credentials at https://docs.direct.worldline-solutions.com/
# =============================================================================
WORLDLINE_MERCHANT_ID=
WORLDLINE_API_KEY=
WORLDLINE_SECRET_KEY=
WORLDLINE_HOST=payment.preprod.direct.worldline-solutions.com
WORLDLINE_ENVIRONMENT=test

# Webhook credentials — configure in the Worldline dashboard and set both.
# Without them, /api/worldline/webhook returns 503 (signature verification is
# mandatory). The client-side /payment-status poll still works as a fallback.
WORLDLINE_WEBHOOK_KEY_ID=
WORLDLINE_WEBHOOK_SECRET=

# =============================================================================
# Anthropic (optional — the concierge returns a friendly canned reply without)
# -----------------------------------------------------------------------------
# Get a key at https://console.anthropic.com/
# =============================================================================
ANTHROPIC_API_KEY=

# =============================================================================
# Cloudflare Turnstile (required in production; dev mode allows missing)
# -----------------------------------------------------------------------------
# Create a site at https://dash.cloudflare.com/?to=/:account/turnstile
# VITE_TURNSTILE_SITE_KEY is baked into the frontend at build time.
# TURNSTILE_ALLOWED_HOSTNAMES is an optional comma-separated list; if unset,
# only the hostname of FRONTEND_URL is accepted.
# =============================================================================
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=

# =============================================================================
# Database TLS (production hardening)
# -----------------------------------------------------------------------------
# Production DB connections verify certificates by default. Set PGSSLROOTCERT
# to point at your trust anchor, or (LAST RESORT) set PGSSL_INSECURE=1 to
# accept any certificate — only acceptable for scratch environments.
# =============================================================================
PGSSLROOTCERT=
PGSSL_INSECURE=

# =============================================================================
# JWT (optional — if set, enables Bearer auth on /chat and /checkout so a
# logged-in user's payments/conversations are attributed to them. Leave blank
# for pure guest mode)
# =============================================================================
JWT_SECRET=
